# CodeWithQuirk env template. Copy to `.env` and fill in.
# `.env` is gitignored. Values on their own line, NO text after the value.

# --- Secrets (API keys / tokens) ---
OPENROUTER_API_KEY=
E2B_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
BLOTATO_API_KEY=

# --- ElevenLabs voice (Coddy) ---
# TTS model: eleven_v3 (expressive, emotion tags) or eleven_multilingual_v2
ELEVENLABS_MODEL_ID=eleven_v3
ELEVENLABS_VOICE_ID=
# optional delivery tuning for eleven_v3: 0.0 (creative) | 0.5 (natural) | 1.0 (robust)
ELEVENLABS_STABILITY=

# --- Operator / safety ---
# your Telegram numeric chat id — bot only obeys this id
TELEGRAM_OPERATOR_CHAT_ID=

# --- Publishing (Blotato) ---
# account ids from the Blotato dashboard
BLOTATO_INSTAGRAM_ID=
BLOTATO_FACEBOOK_ID=
# Facebook also needs the Page id
BLOTATO_FACEBOOK_PAGE_ID=
BLOTATO_TIKTOK_ID=
# which platforms to post to (comma-separated)
PUBLISH_TARGETS=instagram,facebook,tiktok
# platforms to hand off for MANUAL posting instead of auto-posting (comma-separated).
# Delivered to the operator in Telegram as video + caption. Excluded from auto-publish.
# e.g. a new TikTok account that gets shadow-banned for auto-posting:
MANUAL_TARGETS=
# keep true until ready to post for real (approving will NOT hit real socials while true)
USE_MOCK_PUBLISHER=true

# --- App config ---
DATABASE_PATH=./data/coddy.db
# container public https URL (for serving the MP4 to Blotato); leave blank to upload via Blotato
PUBLIC_BASE_URL=
OUTPUT_DIR=./data/media
# optional chiptune/music file looped quietly under the voiceover (leave blank for none)
MUSIC_PATH=
# daily publish slots + timezone
SCHEDULE_SLOTS=09:00,17:00
SCHEDULE_TZ=America/Toronto

# --- Daily auto-topic (optional) ---
# comma-separated languages to rotate through, one per day (blank = auto-topic OFF).
# each morning the bot pulls a top Stack Overflow question for that day's language,
# drafts the full video, and sends it to you with Approve buttons (you still approve).
AUTO_TOPIC_LANGUAGES=
# local time (HH:MM in SCHEDULE_TZ) to generate the auto draft — leave time before
# your earliest publish slot so it's ready to approve
AUTO_TOPIC_HOUR=09:00
# optional StackExchange API key (raises the lookup quota; not needed for 1/day)
STACKOVERFLOW_API_KEY=
