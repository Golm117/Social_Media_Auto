# CodeWithQuirk env template. Copy to `.env` and fill in.
# `.env` is gitignored. Values on their own line, NO text after the value.

# --- Secrets (API keys / tokens) ---
OPENROUTER_API_KEY=
E2B_API_KEY=
ELEVENLABS_API_KEY=
TELEGRAM_BOT_TOKEN=
BLOTATO_API_KEY=

# --- ElevenLabs voice (Coddy) ---
ELEVENLABS_VOICE_ID=

# --- Operator / safety ---
# your Telegram numeric chat id — bot only obeys this id
TELEGRAM_OPERATOR_CHAT_ID=

# --- Publishing (Blotato) ---
# account ids from the Blotato dashboard
BLOTATO_INSTAGRAM_ID=
BLOTATO_FACEBOOK_ID=
# Facebook also needs the Page id
BLOTATO_FACEBOOK_PAGE_ID=
BLOTATO_TIKTOK_ID=
# which platforms to post to (comma-separated)
PUBLISH_TARGETS=instagram,facebook,tiktok
# keep true until ready to post for real (approving will NOT hit real socials while true)
USE_MOCK_PUBLISHER=true

# --- App config ---
DATABASE_PATH=./data/coddy.db
# container public https URL (for serving the MP4 to Blotato); leave blank to upload via Blotato
PUBLIC_BASE_URL=
OUTPUT_DIR=./data/media
# daily publish slots + timezone
SCHEDULE_SLOTS=09:00,17:00
SCHEDULE_TZ=America/Toronto
